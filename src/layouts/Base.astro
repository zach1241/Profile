---
import '../styles/global.css';
import { profile } from '../data/site.js';
const {title='Local Presence 360 | Zachary Swanepoel',description='Practical insights into SEO, analytics, Google Ads, AI and web development from Zachary Swanepoel.',image='/og-default.svg'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#080d10"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site).toString()}/><meta name="twitter:card" content="summary_large_image"/><title>{title}</title></head><body><header class="topbar"><nav class="nav wrap" aria-label="Main navigation"><a class="brand" href="/">LOCAL<span style="color:#b6c6bc">PRESENCE</span><em>360</em><span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden"> Home</span></a><button class="mobilemenu" aria-expanded="false" aria-controls="main-links" type="button">Menu ☰</button><div class="links" id="main-links"><a href="/">Home</a><a href="/projects/">Projects</a><a href="/insights/">Insights</a><a href="/about/">About</a><a href="/services/">Services</a><a href="/contact/" class="navbtn">Let's talk ↗</a></div></nav></header><main><slot/></main><footer class="footer"><div class="wrap footer-inner"><div><a href="/" class="brand" style="font-size:1rem">LOCALPRESENCE<em>360</em></a><div>Built by {profile.short} in Cape Town. © {new Date().getFullYear()}</div></div><div class="footerlinks"><a href="/projects/">Work</a><a href="/insights/">Journal</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></div></div></footer><script>const b=document.querySelector('.mobilemenu');const nav=document.querySelector('#main-links');b?.addEventListener('click',()=>{const open=nav?.classList.toggle('open');b.setAttribute('aria-expanded',String(!!open));});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');b?.setAttribute('aria-expanded','false');}));</script></body></html>