---
import Base from '../../layouts/Base.astro';import {projects} from '../../data/site.js';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;
---
<Base title={project.title+' | Local Presence 360'} description={project.desc}><section class="pagehead"><div class="wrap"><div class="breadcrumbs"><a href="/projects/">Projects</a> / {project.title}</div><div class="eyebrow">{project.sector} • {project.year}</div><h1 class="page-title">{project.title}</h1><p class="lead">{project.desc}</p><div class="chips">{project.stack.map(s=><span class="chip">{s}</span>)}</div></div></section><section class="section"><div class="wrap two-col"><article class="prose" style="padding:0"><h2>The challenge</h2><p>{project.challenge}</p><h2>How I approached it</h2><ul class="listcheck">{project.approach.map(a=><li>{a}</li>)}</ul><h2>What I took away</h2><p>{project.learning}</p><p style="font-size:.85rem;color:#90a69a">This case study focuses on scope and technical approach. No unverified performance metrics or client outcomes are claimed.</p><a class="back" href="/projects/">← Back to all projects</a></article><aside class="aside"><h3>Project overview</h3><p><strong>Status:</strong> {project.status}</p><p><strong>Category:</strong> {project.sector}</p><p><strong>Year:</strong> {project.year}</p><div class="chips">{project.stack.map(s=><span class="chip">{s}</span>)}</div>{project.url&&<div class="actions"><a class="btn" href={project.url} target="_blank" rel="noopener noreferrer">Visit project ↗</a></div>}</aside></div></section></Base>