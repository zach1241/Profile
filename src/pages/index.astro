---
import Base from '../layouts/Base.astro';import ProjectCard from '../components/ProjectCard.astro';import ArticleCard from '../components/ArticleCard.astro';import {projects,articles,profile} from '../data/site.js';
---
<Base><section class="hero"><div class="wrap"><div class="eyebrow">BUILDING SOFTWARE. GROWING DIGITAL PRESENCE.</div><h1>Where code meets <span>measurable growth.</span></h1><p>I'm Zachary, a developer and digital growth specialist who builds practical software, improves websites and explores what really works in search, advertising and AI.</p><div class="actions"><a class="btn" href="/projects/">Explore my work ↗</a><a class="btn btn-outline" href="/insights/">Read my insights →</a></div><div class="micro"><span>◉ <strong>Cape Town</strong>, South Africa</span><span>↗ Web development & digital strategy</span><span>✦ Building in public</span></div></div></section><section class="section"><div class="wrap"><div class="heading"><div><div class="eyebrow">SELECTED WORK</div><h2>Projects with a purpose.</h2><p>Software, client experiences and experiments worth documenting, including the decisions behind them.</p></div><a class="arrow-link" href="/projects/">All projects ↗</a></div><div class="grid">{projects.slice(0,3).map(project=><ProjectCard project={project}/>)}</div></div></section><section class="section alt"><div class="wrap"><div class="heading"><div><div class="eyebrow">FIELD NOTES & PERSPECTIVES</div><h2>Notes from the work.</h2><p>Lessons from SEO, analytics, ads, development and emerging technology, with a personal take at the end.</p></div><a class="arrow-link" href="/insights/">Browse insights ↗</a></div><div class="grid">{articles.slice(0,3).map(article=><ArticleCard article={article}/>)}</div></div></section><section class="section"><div class="wrap feature"><div class="portrait"><img src={profile.photo} alt="Portrait of Zachary Swanepoel" loading="lazy"/></div><div><div class="eyebrow">THE PERSON BEHIND THE WORK</div><h2>Curious by nature. Practical by design.</h2><p>My work sits between web development, search visibility, paid acquisition and the systems teams need to operate. I enjoy solving the kind of problems that require both technical detail and business context.</p><p>This site is where I document what I'm building, how I approach challenges and what I learn along the way.</p><div class="stats"><div class="stat"><strong>Development</strong>Web apps & websites</div><div class="stat"><strong>Growth</strong>SEO & paid search</div><div class="stat"><strong>Experiments</strong>AI & games</div></div><div class="actions"><a class="btn btn-outline" href="/about/">More about me ↗</a></div></div></div></section><section class="section alt"><div class="wrap cta"><div class="eyebrow">OPEN TO COLLABORATION</div><h2>Have a project that needs both creativity and technical thinking?</h2><p>Let's talk about a website, internal tool, SEO system or a new idea.</p><div class="actions"><a class="btn" href="/contact/">Get in touch ↗</a></div></div></section></Base>