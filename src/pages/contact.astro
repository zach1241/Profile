---
import Base from '../layouts/Base.astro';import {profile} from '../data/site.js';
---
<Base title="Contact | Local Presence 360"><section class="pagehead"><div class="wrap"><div class="eyebrow">LET'S CONNECT</div><h1 class="page-title">Tell me what you're building.</h1><p class="lead">Whether it's a new website, an internal tool or better search visibility, I'm always interested in thoughtful projects.</p></div></section><section class="section"><div class="wrap"><div class="cta"><div class="eyebrow">DIRECT CONTACT</div><h2>Good projects start with a clear conversation.</h2><p>Email me with the context, the problem you're solving and the next step you have in mind.</p><div class="actions"><a class="btn" href={'mailto:'+profile.email+'?subject=Project%20enquiry%20via%20Local%20Presence%20360'}>Send an email ↗</a><a class="btn btn-outline" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn ↗</a></div></div></div></section></Base>